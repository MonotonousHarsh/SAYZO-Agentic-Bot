# Copy this file to .env (same folder) and fill in real values. Never commit .env.

# --- LLM: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# A model that supports strict structured outputs on Groq.
GROQ_MODEL=openai/gpt-oss-120b

# --- Database: Supabase Postgres ---
# Supabase dashboard -> Connect -> "Session pooler" URI (port 5432). Paste it as shown,
# with your database password filled in.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
