# Copy this file to .env (same folder) and fill in real values. Never commit .env.

# --- LLM: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# A model that supports strict structured outputs on Groq.
GROQ_MODEL=openai/gpt-oss-120b

# --- Database: Supabase Postgres ---
# Supabase dashboard -> Connect -> "Session pooler" URI (port 5432). Paste it as shown,
# with your database password filled in.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Sign-in: Supabase Auth (dashboard -> Project Settings -> API Keys) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public: the browser uses it to sign in.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret: only scripts/create_demo_users.py uses it. Never put it in frontend code.
SUPABASE_SECRET_KEY=sb_secret_...
# Only for projects still using the legacy JWT secret (new projects verify via JWKS).
# SUPABASE_JWT_SECRET=

# --- Answering ---
# Chunks less similar than this are not shown to the model (unrelated text scores ~0.40).
# ANSWER_MIN_SIMILARITY=0.5
# TIMEZONE=Asia/Kolkata
